{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Gestión de Países",
    "description": "API para consultar países por código en Odoo.\n\n## Autenticación\nTodos los endpoints requieren la cabecera `X-API-Key`.\n\n## Formato de respuesta\nLas respuestas incluyen `success` y `message`. Cuando aplica, también incluyen `data` o `error_code`.\n\n## Saneado del código de país\nEl endpoint valida `code_country` con `CountryGetSchema`, elimina los espacios al inicio y al final del código, elimina `%` y `_`, normaliza el valor a mayúsculas y realiza una búsqueda insensible a mayúsculas y minúsculas.\n\n## Códigos de error\n- `INVALID_API_KEY`: autenticación fallida\n- `INVALID_PARAMETERS`: error de validación\n- `RECORD_NOT_FOUND`: recurso no encontrado\n- `INTERNAL_SERVER_ERROR`: error inesperado\n",
    "version": "1.0.0",
    "license": {
      "name": "LGPL-3.0-or-later",
      "url": "https://www.gnu.org/licenses/lgpl-3.0.html"
    },
    "contact": {
      "name": "Punt Sistemes"
    }
  },
  "servers": [
    {
      "url": "{protocol}://{host}:{port}{basePath}",
      "description": "Configuración Personalizada del Servidor",
      "variables": {
        "protocol": {
          "enum": [
            "http",
            "https"
          ],
          "default": "http",
          "description": "Protocolo (http o https)"
        },
        "host": {
          "default": "localhost",
          "description": "Nombre de host o dirección IP del servidor"
        },
        "port": {
          "default": "8069",
          "description": "Número de puerto del servidor"
        },
        "basePath": {
          "default": "/api/v1",
          "description": "Ruta base de la API"
        }
      }
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key para autenticación"
      }
    },
    "schemas": {
      "ValidationErrorItem": {
        "type": "object",
        "description": "Elemento individual de error de validación.",
        "properties": {
          "type": {
            "type": "string"
          },
          "loc": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "msg": {
            "type": "string"
          },
          "input": {}
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "description": "Envelope de error estándar de la API.",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ValidationErrorResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiErrorResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "validation_errors": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ValidationErrorItem"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "CountryGetSuccessResponse": {
        "type": "object",
        "description": "Respuesta satisfactoria al consultar un país.",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "odoo_id": {
                "type": "integer",
                "description": "Identificador interno de Odoo."
              },
              "erp_id": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean",
                    "enum": [
                      false
                    ]
                  }
                ],
                "description": "Identificador en el sistema ERP, o false si no está asignado."
              },
              "name": {
                "type": "string",
                "description": "Nombre del país."
              },
              "metadata": {
                "type": "array",
                "description": "Metadatos de la compañía asociada al registro.",
                "items": {
                  "type": "object",
                  "properties": {
                    "company_id": {
                      "oneOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        }
                      ],
                      "description": "Identificador de la compañía, o false si no tiene compañía asignada."
                    },
                    "company_name": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        }
                      ],
                      "description": "Nombre de la compañía, o false si no tiene compañía asignada."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/countries/{code_country}": {
      "get": {
        "summary": "Obtener país",
        "description": "Obtiene el país cuyo código, una vez validado con `CountryGetSchema` y saneado, coincide con el valor indicado. El endpoint elimina los espacios al inicio y al final, elimina `%` y `_`, normaliza el código a mayúsculas y delega la búsqueda al modelo con comparación insensible a mayúsculas y minúsculas. Devuelve 404 cuando no encuentra ningún registro.\n",
        "operationId": "get_country",
        "tags": [
          "Países"
        ],
        "parameters": [
          {
            "name": "code_country",
            "in": "path",
            "required": true,
            "description": "Código del país. Se eliminan los espacios al inicio y al final, así como los caracteres `%` y `_`, antes de buscar. El valor resultante se normaliza a mayúsculas y la búsqueda es insensible a mayúsculas y minúsculas.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "example": "ES"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "País encontrado correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountryGetSuccessResponse"
                },
                "example": {
                  "success": true,
                  "message": "Record found successfully",
                  "data": {
                    "odoo_id": 1,
                    "erp_id": 88888,
                    "name": "España",
                    "metadata": [
                      {
                        "company_id": 1,
                        "company_name": "Compañía Principal"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud incorrecta - Parámetros de entrada inválidos o errores de validación",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "examples": {
                  "validation_error": {
                    "summary": "Error de validación de parámetros",
                    "value": {
                      "success": false,
                      "error_code": "INVALID_PARAMETERS",
                      "message": "Validation error in request parameters",
                      "data": {
                        "validation_errors": [
                          {
                            "type": "string_too_long",
                            "loc": [
                              "code_country"
                            ],
                            "msg": "String should have at most 16 characters",
                            "input": "AAAAAAAAAAAAAAAAA"
                          }
                        ]
                      }
                    }
                  },
                  "odoo_error": {
                    "summary": "Error de validación de Odoo",
                    "value": {
                      "success": false,
                      "error_code": "INVALID_PARAMETERS",
                      "message": "Error description from Odoo"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado - API key inválida o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "success": false,
                  "error_code": "INVALID_API_KEY",
                  "message": "Invalid or missing API key"
                }
              }
            }
          },
          "404": {
            "description": "No encontrado - El país con este código no existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "success": false,
                  "error_code": "RECORD_NOT_FOUND",
                  "message": "Record not found: ZZ"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor - Se devuelve el texto de la excepción capturada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "success": false,
                  "error_code": "INTERNAL_SERVER_ERROR",
                  "message": "Unexpected error message"
                }
              }
            }
          }
        }
      }
    }
  }
}
