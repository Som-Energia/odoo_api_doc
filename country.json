{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Gestión de Países",
    "description": "API para obtener información de países por código de país en Odoo.\n\n## Autenticación\nTodos los endpoints requieren autenticación mediante API key a través de la cabecera `X-API-Key`.\n\n## Formato de Respuesta\nTodas las respuestas siguen un formato estándar con los campos `success`, `message`, y opcionalmente `data` o `error_code`.\n\n## Códigos de Error\n- `INVALID_API_KEY`: Autenticación fallida\n- `RECORD_NOT_FOUND`: Recurso no encontrado (estado 404)\n- `INTERNAL_SERVER_ERROR`: Error inesperado (estado 500)\n",
    "version": "1.0.0",
    "contact": {
      "name": "Punt Sistemes"
    }
  },
  "servers": [
    {
      "url": "{protocol}://{host}:{port}{basePath}",
      "description": "Configuración Personalizada del Servidor",
      "variables": {
        "protocol": {
          "enum": [
            "http",
            "https"
          ],
          "default": "http",
          "description": "Protocolo (http o https)"
        },
        "host": {
          "default": "localhost",
          "description": "Nombre de host o dirección IP del servidor"
        },
        "port": {
          "default": "8069",
          "description": "Número de puerto del servidor"
        },
        "basePath": {
          "default": "/api/v1",
          "description": "Ruta base de la API"
        }
      }
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key para autenticación"
      }
    },
    "schemas": {
      "Country": {
        "type": "object",
        "properties": {
          "odoo_id": {
            "type": "integer"
          },
          "erp_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "code_country": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/country/{code_country}": {
      "get": {
        "summary": "Obtener País",
        "description": "Recupera un país específico por su código.\n\nEl endpoint busca una coincidencia (insensible a mayúsculas/minúsculas) del código de país saneado. Devuelve 404 si no existe ningún registro coincidente.\n",
        "operationId": "get_country",
        "tags": [
          "Países"
        ],
        "parameters": [
          {
            "name": "code_country",
            "in": "path",
            "required": true,
            "description": "El código de país a buscar (ej. 'ES', 'FR')",
            "schema": {
              "type": "string",
              "example": "ES"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "País encontrado correctamente",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Record found successfully",
                  "data": {
                    "odoo_id": 1,
                    "erp_id": 10001,
                    "name": "España",
                    "metadata": [
                      {
                        "company_id": 1,
                        "company_name": "Compañía Principal"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado - API key inválida, ausente o expirada",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INVALID_API_KEY",
                  "message": "Invalid or missing API key"
                }
              }
            }
          },
          "404": {
            "description": "No encontrado - El país con este código no existe",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "RECORD_NOT_FOUND",
                  "message": "Record not found: ES"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor - Ocurrió un error inesperado",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INTERNAL_SERVER_ERROR",
                  "message": "An internal server error occurred"
                }
              }
            }
          }
        }
      }
    }
  }
}
