{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Gestión de Cuentas Bancarias",
    "description": "API para obtener y crear cuentas bancarias asociadas a proveedores en Odoo.\n\n## Autenticación\nTodos los endpoints requieren autenticación mediante API key a través de la cabecera `X-API-Key`.\n\n## Formato de Respuesta\nTodas las respuestas siguen un formato estándar con los campos `success`, `message`, y opcionalmente `data` o `error_code`.\n\n## Códigos de Error\n- `INVALID_API_KEY`: Autenticación fallida\n- `RECORD_NOT_FOUND`: Recurso no encontrado (estado 404)\n- `INVALID_PARAMETERS`: Error de validación, incluyendo dígitos de control inválidos (estado 400)\n- `DUPLICATE_KEY_VALUE`: Recurso duplicado (estado 409)\n- `INTERNAL_SERVER_ERROR`: Error inesperado (estado 500)\n",
    "version": "1.0.0",
    "contact": {
      "name": "Punt Sistemes"
    }
  },
  "servers": [
    {
      "url": "{protocol}://{host}:{port}{basePath}",
      "description": "Configuración Personalizada del Servidor",
      "variables": {
        "protocol": {
          "enum": [
            "http",
            "https"
          ],
          "default": "http",
          "description": "Protocolo (http o https)"
        },
        "host": {
          "default": "localhost",
          "description": "Nombre de host o dirección IP del servidor"
        },
        "port": {
          "default": "8069",
          "description": "Número de puerto del servidor"
        },
        "basePath": {
          "default": "/api/v1",
          "description": "Ruta base de la API"
        }
      }
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key para autenticación"
      }
    },
    "schemas": {
      "BankAccount": {
        "type": "object",
        "properties": {
          "odoo_id": {
            "type": "integer"
          },
          "erp_id": {
            "type": "integer"
          },
          "acc_number": {
            "type": "string"
          },
          "partner_id": {
            "type": "integer"
          }
        }
      },
      "BankCreateRequest": {
        "type": "object",
        "required": [
          "pnt_erp_id",
          "acc_number",
          "partner_id"
        ],
        "properties": {
          "pnt_erp_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Identificador ERP (>0)."
          },
          "acc_number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Número de cuenta bancaria (IBAN)."
          },
          "partner_id": {
            "type": "integer",
            "minimum": 1,
            "description": "ID del partner en Odoo (>0)."
          }
        }
      }
    }
  },
  "paths": {
    "/banks/{partner_id}": {
      "get": {
        "summary": "Obtener Cuenta Bancaria",
        "description": "Recupera una cuenta bancaria específica para un partner dado por número de cuenta.\n\nEl endpoint busca una coincidencia exacta del número de cuenta saneado asociado al partner especificado. Devuelve 404 si no existe ningún registro coincidente.\n",
        "operationId": "get_bank_number",
        "tags": [
          "Cuentas Bancarias"
        ],
        "parameters": [
          {
            "name": "partner_id",
            "in": "path",
            "required": true,
            "description": "El ID de la base de datos de Odoo del partner",
            "schema": {
              "type": "integer",
              "example": 45
            }
          },
          {
            "name": "acc_number",
            "in": "query",
            "required": true,
            "description": "El número de cuenta bancaria a buscar (será saneado)",
            "schema": {
              "type": "string",
              "example": "ES9121000418450200051332"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cuenta bancaria encontrada correctamente",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Record found successfully",
                  "data": {
                    "odoo_id": 123,
                    "erp_id": 70001,
                    "name": "ES9121000418450200051332",
                    "metadata": [
                      {
                        "company_id": 1,
                        "company_name": "Compañía Principal"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud incorrecta - Error de validación de Odoo",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INVALID_PARAMETERS",
                  "message": "Error description from Odoo"
                }
              }
            }
          },
          "401": {
            "description": "No autorizado - API key inválida, ausente o expirada",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INVALID_API_KEY",
                  "message": "Invalid or missing API key"
                }
              }
            }
          },
          "404": {
            "description": "No encontrado - La cuenta bancaria no existe para este partner",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "RECORD_NOT_FOUND",
                  "message": "Record not found: 45 - ES9121000418450200051332"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor - Ocurrió un error inesperado",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INTERNAL_SERVER_ERROR",
                  "message": "An internal server error occurred"
                }
              }
            }
          }
        }
      }
    },
    "/banks": {
      "post": {
        "summary": "Crear Cuenta Bancaria",
        "description": "Crea una nueva cuenta bancaria para un proveedor.\n\nEl endpoint identifica y asigna automáticamente el banco a partir del número de cuenta si es posible.\n\nNo se permiten campos adicionales en el cuerpo de la solicitud (extra fields forbidden).\n\nDevuelve 409 si ya existe una cuenta duplicada.\n",
        "operationId": "create_bank_number",
        "tags": [
          "Cuentas Bancarias"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BankCreateRequest"
              },
              "example": {
                "acc_number": "ES7620770024003102575766",
                "partner_id": 45,
                "pnt_erp_id": 70003
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cuenta bancaria creada correctamente",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Record created successfully",
                  "data": {
                    "odoo_id": 124,
                    "erp_id": 70003,
                    "values": {
                      "acc_number": "ES7620770024003102575766",
                      "partner_id": 45,
                      "pnt_erp_id": 70003
                    },
                    "metadata": [
                      {
                        "company_id": 1,
                        "company_name": "Compañía Principal"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud incorrecta - Parámetros de entrada inválidos, errores de validación o dígitos de control inválidos.\nEste error ocurre cuando:\n- Faltan campos obligatorios o están vacíos\n- Los valores de los campos no cumplen con las reglas de validación\n- El número de cuenta bancaria tiene dígitos de control inválidos (falló la validación IBAN)\n",
            "content": {
              "application/json": {
                "examples": {
                  "validation_error": {
                    "summary": "Error de validación por campo vacío",
                    "value": {
                      "success": false,
                      "error_code": "INVALID_PARAMETERS",
                      "message": "Validation error in request parameters",
                      "data": {
                        "validation_errors": [
                          {
                            "type": "value_error",
                            "loc": [
                              "acc_number"
                            ],
                            "msg": "String should have at least 1 character",
                            "input": ""
                          }
                        ]
                      }
                    }
                  },
                  "invalid_checksum": {
                    "summary": "Dígitos de control inválidos en el número de cuenta bancaria",
                    "value": {
                      "success": false,
                      "error_code": "INVALID_PARAMETERS",
                      "message": "Validation error in request parameters",
                      "data": {
                        "validation_errors": [
                          {
                            "loc": [
                              "acc_number"
                            ],
                            "msg": "Invalid checksum digits",
                            "type": "value_error"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado - API key inválida, ausente o expirada",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INVALID_API_KEY",
                  "message": "Invalid or missing API key"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto - Ya existe una cuenta bancaria con este número para este partner",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "DUPLICATE_KEY_VALUE",
                  "message": "Record with provided key already exists: duplicate key value violates unique constraint"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor - Ocurrió un error inesperado",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INTERNAL_SERVER_ERROR",
                  "message": "An internal server error occurred"
                }
              }
            }
          }
        }
      }
    }
  }
}
