{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Gestión de Cuentas Contables",
    "description": "API para obtener y crear cuentas contables en Odoo.\n\n## Autenticación\nTodos los endpoints requieren autenticación mediante API key a través de la cabecera `X-API-Key`.\n\n## Formato de Respuesta\nTodas las respuestas siguen un formato estándar con los campos `success`, `message`, y opcionalmente `data` o `error_code`.\n\n## Comportamiento Multi-Compañía\nAl crear una cuenta, la API crea automáticamente la misma cuenta (sin ERP ID) en todas las demás compañías donde aún no exista. Las cuentas replicadas se devuelven dentro de `metadata[0].new_accounts_by_company`.\n\n## Códigos de Error\n- `INVALID_API_KEY`: Autenticación fallida\n- `RECORD_NOT_FOUND`: Recurso no encontrado (estado 404)\n- `INVALID_PARAMETERS`: Error de validación (estado 400)\n- `DUPLICATE_KEY_VALUE`: Recurso duplicado (estado 409)\n- `INTERNAL_SERVER_ERROR`: Error inesperado (estado 500)\n",
    "version": "1.0.0",
    "contact": {
      "name": "Punt Sistemes"
    }
  },
  "servers": [
    {
      "url": "{protocol}://{host}:{port}{basePath}",
      "description": "Configuración Personalizada del Servidor",
      "variables": {
        "protocol": {
          "enum": [
            "http",
            "https"
          ],
          "default": "http",
          "description": "Protocolo (http o https)"
        },
        "host": {
          "default": "localhost",
          "description": "Nombre de host o dirección IP del servidor"
        },
        "port": {
          "default": "8069",
          "description": "Número de puerto del servidor"
        },
        "basePath": {
          "default": "/api/v1",
          "description": "Ruta base de la API"
        }
      }
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key para autenticación"
      }
    },
    "schemas": {
      "AccountCreateRequest": {
        "type": "object",
        "required": [
          "pnt_erp_id",
          "name",
          "code"
        ],
        "properties": {
          "pnt_erp_id": {
            "type": "integer",
            "description": "Identificador único del sistema ERP. Debe ser mayor que 0.",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "description": "Nombre de la cuenta contable.",
            "minLength": 1,
            "maxLength": 256
          },
          "code": {
            "type": "string",
            "description": "Código de la cuenta contable.",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    }
  },
  "paths": {
    "/accounts/{code}": {
      "get": {
        "summary": "Obtener Cuenta",
        "description": "Obtiene una cuenta específica por su código.\n\nEl endpoint busca una coincidencia exacta del código de cuenta saneado.\nLos espacios en blanco se recortan del código antes de buscar.\nDevuelve 404 si no existe ningún registro coincidente.\n",
        "operationId": "get_account",
        "tags": [
          "Cuentas"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "El código de cuenta a buscar (se recortarán los espacios en blanco)",
            "schema": {
              "type": "string",
              "example": "700000"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cuenta encontrada correctamente",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Record found successfully",
                  "data": {
                    "odoo_id": 123,
                    "erp_id": 50001,
                    "name": "700000 - Ingresos por ventas",
                    "metadata": [
                      {
                        "company_id": 1,
                        "company_name": "Compañía Principal",
                        "code": "700000",
                        "name": "Ingresos por ventas"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud incorrecta - Error de validación de Odoo",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INVALID_PARAMETERS",
                  "message": "Error description from Odoo"
                }
              }
            }
          },
          "401": {
            "description": "No autorizado - API key inválida, ausente o expirada",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INVALID_API_KEY",
                  "message": "Invalid or missing API key"
                }
              }
            }
          },
          "404": {
            "description": "No encontrado - La cuenta con este código no existe",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "RECORD_NOT_FOUND",
                  "message": "Record not found: 700000"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor - Ocurrió un error inesperado",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INTERNAL_SERVER_ERROR",
                  "message": "An internal server error occurred"
                }
              }
            }
          }
        }
      }
    },
    "/accounts": {
      "post": {
        "summary": "Crear Cuenta",
        "description": "Crea una nueva cuenta contable.\n\nEl endpoint valida los datos de entrada y crea un nuevo registro de cuenta.\nAdemás, crea automáticamente la misma cuenta (sin ERP ID) en todas las demás compañías donde no exista.\nLas cuentas replicadas se devuelven dentro de `metadata[0].new_accounts_by_company`.\n\nNo se permiten campos adicionales en el cuerpo de la solicitud (extra fields forbidden).\n\nDevuelve 409 si ya existe una cuenta duplicada.\n",
        "operationId": "create_account",
        "tags": [
          "Cuentas"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountCreateRequest"
              },
              "example": {
                "name": "Ingresos por ventas",
                "code": "700000",
                "pnt_erp_id": 50001
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cuenta creada correctamente",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Record created successfully",
                  "data": {
                    "odoo_id": 124,
                    "erp_id": 50001,
                    "values": {
                      "name": "Ingresos por ventas",
                      "code": "700000"
                    },
                    "metadata": [
                      {
                        "company_id": 1,
                        "company_name": "Compañía Principal",
                        "code": "700000",
                        "name": "Ingresos por ventas",
                        "new_accounts_by_company": [
                          {
                            "odoo_id": 125,
                            "erp_id": false,
                            "company": "Compañía Secundaria",
                            "metadata": [
                              {
                                "company_id": 2,
                                "company_name": "Compañía Secundaria",
                                "code": "700000",
                                "name": "Ingresos por ventas"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud incorrecta - Parámetros de entrada inválidos o errores de validación",
            "content": {
              "application/json": {
                "examples": {
                  "missing_field": {
                    "summary": "Campo obligatorio faltante",
                    "value": {
                      "success": false,
                      "error_code": "INVALID_PARAMETERS",
                      "message": "Validation error in request parameters",
                      "data": {
                        "validation_errors": [
                          {
                            "type": "missing",
                            "loc": [
                              "code"
                            ],
                            "msg": "Field required"
                          }
                        ]
                      }
                    }
                  },
                  "invalid_value": {
                    "summary": "Valor de campo inválido",
                    "value": {
                      "success": false,
                      "error_code": "INVALID_PARAMETERS",
                      "message": "Validation error in request parameters",
                      "data": {
                        "validation_errors": [
                          {
                            "type": "string_too_short",
                            "loc": [
                              "name"
                            ],
                            "msg": "String should have at least 1 character",
                            "input": ""
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado - API key inválida, ausente o expirada",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INVALID_API_KEY",
                  "message": "Invalid or missing API key"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto - Ya existe una cuenta con este ERP ID o código",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "DUPLICATE_KEY_VALUE",
                  "message": "Duplicate key value: duplicate key value violates unique constraint \"account_account_pnt_erp_id_uniq\""
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor - Ocurrió un error inesperado",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INTERNAL_SERVER_ERROR",
                  "message": "An internal server error occurred"
                }
              }
            }
          }
        }
      }
    }
  }
}
