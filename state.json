{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Gestión de Estados/Provincias",
    "description": "API para obtener y crear información de estados/provincias en Odoo.\n\n## Autenticación\nTodos los endpoints requieren autenticación mediante API key a través de la cabecera `X-API-Key`.\n\n## Formato de Respuesta\nTodas las respuestas siguen un formato estándar con los campos `success`, `message`, y opcionalmente `data` o `error_code`.\n\n## Códigos de Error\n- `INVALID_API_KEY`: Autenticación fallida\n- `RECORD_NOT_FOUND`: Recurso no encontrado (estado 404)\n- `INVALID_PARAMETERS`: Error de validación (estado 400)\n- `INVALID_FOREIGN_KEY`: Violación de clave foránea (estado 400)\n- `DUPLICATE_KEY_VALUE`: Recurso duplicado (estado 409)\n- `INTERNAL_SERVER_ERROR`: Error inesperado (estado 500)\n",
    "version": "1.0.0",
    "contact": {
      "name": "Punt Sistemes"
    }
  },
  "servers": [
    {
      "url": "{protocol}://{host}:{port}{basePath}",
      "description": "Configuración Personalizada del Servidor",
      "variables": {
        "protocol": {
          "enum": [
            "http",
            "https"
          ],
          "default": "http",
          "description": "Protocolo (http o https)"
        },
        "host": {
          "default": "localhost",
          "description": "Nombre de host o dirección IP del servidor"
        },
        "port": {
          "default": "8069",
          "description": "Número de puerto del servidor"
        },
        "basePath": {
          "default": "/api/v1",
          "description": "Ruta base de la API"
        }
      }
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key para autenticación"
      }
    },
    "schemas": {
      "State": {
        "type": "object",
        "properties": {
          "odoo_id": {
            "type": "integer"
          },
          "erp_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "code_country": {
            "type": "string"
          }
        }
      },
      "StateCreateRequest": {
        "type": "object",
        "required": [
          "pnt_erp_id",
          "name",
          "code",
          "country_id"
        ],
        "properties": {
          "pnt_erp_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Identificador único del sistema ERP. Debe ser mayor que 0."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Nombre de la provincia/estado. De 1 a 256 caracteres."
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Código de la provincia/estado. De 1 a 64 caracteres. Se convierte automáticamente a mayúsculas."
          },
          "country_id": {
            "type": "integer",
            "minimum": 1,
            "description": "ID del país en Odoo al que pertenece la provincia. Debe ser mayor que 0."
          }
        }
      }
    }
  },
  "paths": {
    "/states/{code_country}/{code}": {
      "get": {
        "summary": "Obtener Estado/Provincia",
        "description": "Recupera un estado/provincia específico por código de país y código de estado.\n\nEl endpoint busca una coincidencia (insensible a mayúsculas/minúsculas) del código de estado saneado dentro del país especificado. Devuelve 404 si no existe ningún registro coincidente.\n",
        "operationId": "get_state",
        "tags": [
          "Estados"
        ],
        "parameters": [
          {
            "name": "code_country",
            "in": "path",
            "required": true,
            "description": "El código del país (ej. 'ES', 'FR')",
            "schema": {
              "type": "string",
              "example": "ES"
            }
          },
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "El código del estado/provincia a buscar",
            "schema": {
              "type": "string",
              "example": "V"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estado/provincia encontrado correctamente",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Record found successfully",
                  "data": {
                    "odoo_id": 1,
                    "erp_id": 10001,
                    "name": "Valencia",
                    "metadata": [
                      {
                        "company_id": 1,
                        "company_name": "Compañía Principal"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado - API key inválida, ausente o expirada",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INVALID_API_KEY",
                  "message": "Invalid or missing API key"
                }
              }
            }
          },
          "404": {
            "description": "No encontrado - El estado con este código no existe",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "RECORD_NOT_FOUND",
                  "message": "Record not found: ES - V"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor - Ocurrió un error inesperado",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INTERNAL_SERVER_ERROR",
                  "message": "An internal server error occurred"
                }
              }
            }
          }
        }
      }
    },
    "/states": {
      "post": {
        "summary": "Crear Estado/Provincia",
        "description": "Crea un nuevo registro de estado/provincia.\n\nEl endpoint valida los datos de entrada y crea un nuevo registro de estado. Devuelve 409 si ya existe un estado duplicado.\n",
        "operationId": "create_state",
        "tags": [
          "Estados"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StateCreateRequest"
              },
              "example": {
                "name": "Valencia",
                "code": "V",
                "country_id": 68,
                "pnt_erp_id": 10001
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Estado/provincia creado correctamente",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Record created successfully",
                  "data": {
                    "odoo_id": 1,
                    "erp_id": 10001,
                    "values": {
                      "name": "Valencia",
                      "code": "V",
                      "country_id": 68,
                      "pnt_erp_id": 10001
                    },
                    "metadata": [
                      {
                        "company_id": 1,
                        "company_name": "Compañía Principal"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud incorrecta - Parámetros de entrada inválidos o violación de clave foránea.\nEste error ocurre cuando:\n- Faltan campos obligatorios o están vacíos\n- Los valores de los campos no cumplen con las reglas de validación\n- El country_id no existe\n",
            "content": {
              "application/json": {
                "examples": {
                  "validation_error": {
                    "summary": "Error de validación por campo vacío",
                    "value": {
                      "success": false,
                      "error_code": "INVALID_PARAMETERS",
                      "message": "Validation error in request parameters",
                      "data": {
                        "validation_errors": [
                          {
                            "type": "value_error",
                            "loc": [
                              "name"
                            ],
                            "msg": "String should have at least 1 character",
                            "input": ""
                          }
                        ]
                      }
                    }
                  },
                  "foreign_key_error": {
                    "summary": "Referencia de país inválida",
                    "value": {
                      "success": false,
                      "error_code": "INVALID_FOREIGN_KEY",
                      "message": "Invalid foreign key reference: insert or update on table \"res_country_state\" violates foreign key constraint"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado - API key inválida, ausente o expirada",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INVALID_API_KEY",
                  "message": "Invalid or missing API key"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto - Ya existe un estado con este código para este país",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "DUPLICATE_KEY_VALUE",
                  "message": "Record with provided key already exists: duplicate key value violates unique constraint"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor - Ocurrió un error inesperado",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": "INTERNAL_SERVER_ERROR",
                  "message": "An internal server error occurred"
                }
              }
            }
          }
        }
      }
    }
  }
}
