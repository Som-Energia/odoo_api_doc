{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Gestión de Provincias o Estados",
    "description": "API para consultar y crear provincias o estados en Odoo.\n\n## Autenticación\nTodos los endpoints requieren la cabecera `X-API-Key`.\n\n## Formato de respuesta\nLas respuestas incluyen `success` y `message`. Cuando aplica, también incluyen `data` o `error_code`.\n\n## Saneado y normalización\nEn GET, `code_country` y `code` eliminan espacios al inicio y al final, eliminan `%` y `_`, se normalizan a mayúsculas y la búsqueda del código de provincia es insensible a mayúsculas y minúsculas. En POST, `code` también se recorta y se normaliza a mayúsculas antes de crear el registro.\n\n## Códigos de error\n- `INVALID_API_KEY`: autenticación fallida\n- `INVALID_PARAMETERS`: error de validación\n- `RECORD_NOT_FOUND`: recurso no encontrado\n- `DUPLICATE_KEY_VALUE`: conflicto por clave única\n- `INTERNAL_SERVER_ERROR`: error inesperado\n",
    "version": "1.0.0",
    "license": {
      "name": "LGPL-3.0-or-later",
      "url": "https://www.gnu.org/licenses/lgpl-3.0.html"
    },
    "contact": {
      "name": "Punt Sistemes"
    }
  },
  "servers": [
    {
      "url": "{protocol}://{host}:{port}{basePath}",
      "description": "Configuración Personalizada del Servidor",
      "variables": {
        "protocol": {
          "enum": [
            "http",
            "https"
          ],
          "default": "http",
          "description": "Protocolo (http o https)"
        },
        "host": {
          "default": "localhost",
          "description": "Nombre de host o dirección IP del servidor"
        },
        "port": {
          "default": "8069",
          "description": "Número de puerto del servidor"
        },
        "basePath": {
          "default": "/api/v1",
          "description": "Ruta base de la API"
        }
      }
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key para autenticación"
      }
    },
    "schemas": {
      "ValidationErrorItem": {
        "type": "object",
        "description": "Elemento individual de error de validación.",
        "properties": {
          "type": {
            "type": "string"
          },
          "loc": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "msg": {
            "type": "string"
          },
          "input": {}
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "description": "Envelope de error estándar de la API.",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ValidationErrorResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiErrorResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "validation_errors": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ValidationErrorItem"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "StateGetSuccessResponse": {
        "type": "object",
        "description": "Respuesta satisfactoria al consultar una provincia o estado.",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "odoo_id": {
                "type": "integer",
                "description": "Identificador interno de Odoo."
              },
              "erp_id": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean",
                    "enum": [
                      false
                    ]
                  }
                ],
                "description": "Identificador en el sistema ERP, o false si no está asignado."
              },
              "name": {
                "type": "string",
                "description": "Nombre de la provincia o estado."
              },
              "metadata": {
                "type": "array",
                "description": "Metadatos de la compañía asociada al registro.",
                "items": {
                  "type": "object",
                  "properties": {
                    "company_id": {
                      "oneOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        }
                      ]
                    },
                    "company_name": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "StateCreateSuccessResponse": {
        "type": "object",
        "description": "Respuesta satisfactoria al crear una provincia o estado.",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "odoo_id": {
                "type": "integer"
              },
              "erp_id": {
                "type": "integer"
              },
              "values": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "country_id": {
                    "type": "integer"
                  },
                  "pnt_erp_id": {
                    "type": "integer"
                  }
                }
              },
              "metadata": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "company_id": {
                      "type": "integer"
                    },
                    "company_name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "StateCreateRequest": {
        "type": "object",
        "required": [
          "pnt_erp_id",
          "name",
          "code",
          "country_id"
        ],
        "properties": {
          "pnt_erp_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Identificador único del sistema ERP (>0)."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Nombre de la provincia o estado."
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Código de la provincia o estado. Se recorta y se normaliza automáticamente a mayúsculas."
          },
          "country_id": {
            "type": "integer",
            "minimum": 1,
            "description": "ID del país en Odoo (>0)."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/states/{code_country}/{code}": {
      "get": {
        "summary": "Obtener provincia o estado",
        "description": "Obtiene una provincia o estado por código de país y código de provincia. El endpoint valida ambos valores con `StateGetSchema`, elimina espacios al inicio y al final, elimina `%` y `_`, normaliza ambos códigos a mayúsculas y busca la provincia con comparación insensible a mayúsculas y minúsculas. Devuelve 404 cuando no encuentra ningún registro.\n",
        "operationId": "get_state",
        "tags": [
          "Estados"
        ],
        "parameters": [
          {
            "name": "code_country",
            "in": "path",
            "required": true,
            "description": "Código del país. Se eliminan espacios, `%` y `_`, y se normaliza a mayúsculas.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "example": "ES"
            }
          },
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "Código de la provincia o estado. Se eliminan espacios, `%` y `_`, y se normaliza a mayúsculas.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "example": "V"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provincia o estado encontrado correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StateGetSuccessResponse"
                },
                "example": {
                  "success": true,
                  "message": "Record found successfully",
                  "data": {
                    "odoo_id": 1,
                    "erp_id": 80001,
                    "name": "Valencia Test",
                    "metadata": [
                      {
                        "company_id": 1,
                        "company_name": "Compañía Principal"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud incorrecta - Parámetros inválidos o error de validación de Odoo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "examples": {
                  "validation_error": {
                    "summary": "Error de validación de parámetros",
                    "value": {
                      "success": false,
                      "error_code": "INVALID_PARAMETERS",
                      "message": "Validation error in request parameters",
                      "data": {
                        "validation_errors": [
                          {
                            "type": "string_too_long",
                            "loc": [
                              "code"
                            ],
                            "msg": "String should have at most 64 characters",
                            "input": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
                          }
                        ]
                      }
                    }
                  },
                  "odoo_error": {
                    "summary": "Error de validación de Odoo",
                    "value": {
                      "success": false,
                      "error_code": "INVALID_PARAMETERS",
                      "message": "Error description from Odoo"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado - API key inválida o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "success": false,
                  "error_code": "INVALID_API_KEY",
                  "message": "Invalid or missing API key"
                }
              }
            }
          },
          "404": {
            "description": "No encontrado - La provincia con este código no existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "success": false,
                  "error_code": "RECORD_NOT_FOUND",
                  "message": "Record not found: ES - V"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor - Se devuelve el texto de la excepción capturada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "success": false,
                  "error_code": "INTERNAL_SERVER_ERROR",
                  "message": "Unexpected error message"
                }
              }
            }
          }
        }
      }
    },
    "/states": {
      "post": {
        "summary": "Crear provincia o estado",
        "description": "Crea una nueva provincia o estado. El endpoint valida el cuerpo JSON con `StateCreateSchema`, recorta los strings de entrada, normaliza `code` a mayúsculas y delega la creación al modelo `res.country.state`, que valida la existencia del país antes de crear.\n",
        "operationId": "create_state",
        "tags": [
          "Estados"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StateCreateRequest"
              },
              "example": {
                "name": "Valencia Test",
                "code": "V",
                "country_id": 68,
                "pnt_erp_id": 80001
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Provincia o estado creado correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StateCreateSuccessResponse"
                },
                "example": {
                  "success": true,
                  "message": "Record created successfully",
                  "data": {
                    "odoo_id": 1,
                    "erp_id": 80001,
                    "values": {
                      "name": "Valencia Test",
                      "code": "V",
                      "country_id": 68,
                      "pnt_erp_id": 80001
                    },
                    "metadata": [
                      {
                        "company_id": 1,
                        "company_name": "Compañía Principal"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud incorrecta - Parámetros inválidos o país inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "examples": {
                  "validation_error": {
                    "summary": "Error de validación de parámetros",
                    "value": {
                      "success": false,
                      "error_code": "INVALID_PARAMETERS",
                      "message": "Validation error in request parameters",
                      "data": {
                        "validation_errors": [
                          {
                            "type": "string_too_short",
                            "loc": [
                              "name"
                            ],
                            "msg": "String should have at least 1 character",
                            "input": ""
                          }
                        ]
                      }
                    }
                  },
                  "invalid_country": {
                    "summary": "country_id inexistente",
                    "value": {
                      "success": false,
                      "error_code": "INVALID_PARAMETERS",
                      "message": "Validation error in request parameters",
                      "data": {
                        "validation_errors": [
                          {
                            "type": "value_error",
                            "loc": [
                              "country_id"
                            ],
                            "msg": "Invalid country_id: 99999999",
                            "input": 99999999
                          }
                        ]
                      }
                    }
                  },
                  "odoo_error": {
                    "summary": "Error de validación de Odoo",
                    "value": {
                      "success": false,
                      "error_code": "INVALID_PARAMETERS",
                      "message": "Error description from Odoo"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado - API key inválida o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "success": false,
                  "error_code": "INVALID_API_KEY",
                  "message": "Invalid or missing API key"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto - Ya existe un registro con la misma clave única",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "success": false,
                  "error_code": "DUPLICATE_KEY_VALUE",
                  "message": "Record with provided key already exists: duplicate key value violates unique constraint"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor - Se devuelve el texto de la excepción capturada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "success": false,
                  "error_code": "INTERNAL_SERVER_ERROR",
                  "message": "Unexpected error message"
                }
              }
            }
          }
        }
      }
    }
  }
}
